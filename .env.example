# Copy this file to .env.local and fill in values as needed.
# .env.local is gitignored - never commit real secrets.

# Base URL of the backend API this frontend talks to.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional. Public site URL used for metadata/canonical links. Defaults to
# http://localhost:3001 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional. VAPID public key for web push notifications. Leave unset to fall
# back to local-only browser notifications (see src/lib/pushNotifications.ts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
